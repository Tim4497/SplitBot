{
  "name": "splitbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/money.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:cleanup": "tsx src/cleanup.ts",
    "db:erase": "tsx src/erase.ts",
    "format": "prettier --write src tests docs README.md package.json tsconfig.json compose.yaml .github/workflows/ci.yml",
    "format:check": "prettier --check src tests docs README.md package.json tsconfig.json compose.yaml .github/workflows/ci.yml"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "dotenv": "16.6.1",
    "grammy": "1.46.0",
    "prisma": "6.19.0"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
