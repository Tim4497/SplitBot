# Create a bot with @BotFather. Never commit .env or share the token.
BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
BOT_MODE=polling
# Local Node execution, with PostgreSQL published by Compose:
DATABASE_URL=postgresql://splitbot:CHANGE_ME_LOCAL_PASSWORD@127.0.0.1:5432/splitbot?schema=public
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
PORT=3000
# Optional public HTTPS URL for the Mini App; configure the domain with BotFather.
# WEB_APP_URL=https://your-real-domain.example/
# Production: HTTPS reverse proxy forwards this path to app:3000.
WEBHOOK_URL=https://bot.example.com/telegram
# Generate using: openssl rand -hex 32
WEBHOOK_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_SECRET
